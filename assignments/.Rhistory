as.numeric()
#Here, votes are loaded by using the parse_votes function which was created earlier.
votes <- page |>
html_nodes('.ipc-rating-star--voteCount') |>
html_text() |>
sapply(parse_votes)
return(tibble(
title = titles,
year = years,
duration = durations,
rating = ratings,
votes = votes
))
}
