# Scrape Movie Data
scrape_movies <- function(url) {
page <- read_html(url)
titles <- page |>
html_nodes('.ipc-title__text') |>
html_text() |>
tail(-1) |>
head(-1) |>
sapply(clean_text) |>
gsub("^\\d+\\.\\s*", "", x = _) |>  # Fixed this line
str_trim()
# Rest of the function remains the same
years <- page |>
html_nodes('.sc-300a8231-7.eaXxft.dli-title-metadata-item:nth-child(1)') |>
html_text() |>
str_extract("\\d{4}") |>
as.numeric()
durations <- page |>
html_nodes('.sc-300a8231-7.eaXxft.dli-title-metadata-item:nth-child(2)') |>
html_text() |>
sapply(parse_duration)
ratings <- page |>
html_nodes('.ipc-rating-star--rating') |>
html_text() |>
as.numeric()
votes <- page |>
html_nodes('.ipc-rating-star--voteCount') |>
html_text() |>
sapply(parse_votes)
return(tibble(
title = titles,
year = years,
duration = durations,
rating = ratings,
votes = votes
))
}
# Collect data from both URLs
movies_df <- bind_rows(lapply(imdb_urls, scrape_movies))
View(movies_df)
# Analysis Functions
analyze_top_bottom_movies <- function(df, n = 5) {
list(
top = df |> arrange(desc(rating)) |> head(n),
bottom = df |> arrange(rating) |> head(n)
)
}
calculate_yearly_stats <- function(df) {
df |>
group_by(year) |>
summarise(
avg_rating = mean(rating, na.rm = TRUE),
movie_count = n()
)
}
# Visualization Functions
plot_yearly_ratings <- function(stats) {
ggplot(stats, aes(x = year, y = avg_rating)) +
geom_point() +
geom_line() +
labs(
title = "Average IMDb Rating by Year",
x = "Year",
y = "Average Rating"
)
}
plot_movie_count <- function(stats) {
ggplot(stats, aes(x = year, y = movie_count)) +
geom_bar(stat = "identity") +
labs(
title = "Number of Movies by Year",
x = "Year",
y = "Movie Count"
)
}
# Top 1000 Analysis
analyze_top_1000 <- function() {
top_1000_url <- "https://www.imdb.com/search/title/?title_type=feature&groups=top_1000&country_of_origin=TR"
page <- read_html(top_1000_url)
titles <- page |>
html_nodes('.ipc-title__text') |>
html_text() |>
tail(-1) |>
head(-1) |>
sapply(clean_text) |>
gsub("^\\d+\\.\\s*", "", .) |>
str_trim()
years <- page |>
html_nodes('.sc-300a8231-7.eaXxft.dli-title-metadata-item:nth-child(1)') |>
html_text() |>
as.numeric()
top_1000_df <- tibble(
title = titles,
year = years
)
analyze_top_1000 <- function() {
top_1000_url <- "https://www.imdb.com/search/title/?title_type=feature&groups=top_1000&country_of_origin=TR"
page <- read_html(top_1000_url)
# Top 1000 Analysis
analyze_top_1000 <- function() {
top_1000_url <- "https://www.imdb.com/search/title/?title_type=feature&groups=top_1000&country_of_origin=TR"
page <- read_html(top_1000_url)
titles <- page |>
html_nodes('.ipc-title__text') |>
html_text() |>
tail(-1) |>
head(-1) |>
sapply(clean_text) |>
gsub("^\\d+\\.\\s*", "", .) |>
str_trim()
years <- page |>
html_nodes('.sc-300a8231-7.eaXxft.dli-title-metadata-item:nth-child(1)') |>
html_text() |>
as.numeric()
top_1000_df <- tibble(
title = titles,
year = years
)
# Join with main dataset
merged_df <- left_join(top_1000_df, movies_df, by = c("title", "year"))
return(merged_df |> arrange(desc(rating)))
}
