# Load required libraries
library(tidyverse)
library(rvest)
library(stringr)
library(stringi)
# Define IMDb search URLs
imdb_urls <- c(
recent = "https://m.imdb.com/search/title/?title_type=feature&release_date=2010-01-01,2023-12-30&num_votes=2500,&country_of_origin=TR&count=250",
older = "https://m.imdb.com/search/title/?title_type=feature&release_date=,2009-12-31&num_votes=2500,&country_of_origin=TR&count=250"
)
# Helper Functions
clean_text <- function(text) {
text <- iconv(text, from = "UTF-8", to = "ASCII//TRANSLIT", sub = "")
text <- str_trim(text)
return(text)
}
# Helper Functions
clean_text <- function(text) {
text <- iconv(text, from = "UTF-8", to = "ASCII//TRANSLIT", sub = "")
text <- str_trim(text)
return(text)
}
parse_duration <- function(duration) {
if (is.na(duration)) return(NA)
if (grepl("^\\d+h$", duration)) {
hours <- as.numeric(gsub("h$", "", duration))
return(hours * 60)
}
parts <- str_match(duration, "(\\d+)h (\\d+)m")
if (is.na(parts[1])) return(NA)
hours <- as.numeric(parts[2])
minutes <- as.numeric(parts[3])
return(hours * 60 + minutes)
}
parse_votes <- function(vote_str) {
vote_str <- str_replace_all(vote_str, '["\\ ]', "")
vote_str <- str_trim(vote_str)
multiplier <- case_when(
grepl("K", vote_str) ~ 1000,
grepl("M", vote_str) ~ 1e6,
TRUE ~ 1
)
vote_num <- str_replace_all(vote_str, "[()KM]", "") |>
str_replace_all("\\.", "") |>
as.numeric()
return(vote_num * multiplier)
}
# Scrape Movie Data
scrape_movies <- function(url) {
page <- read_html(url)
# Extract basic movie information
titles <- page |>
html_nodes('.ipc-title__text') |>
html_text() |>
tail(-1) |>
head(-1) |>
sapply(clean_text) |>
gsub("^\\d+\\.\\s*", "", .) |>
str_trim()
years <- page |>
html_nodes('.sc-300a8231-7.eaXxft.dli-title-metadata-item:nth-child(1)') |>
html_text() |>
str_extract("\\d{4}") |>
as.numeric()
durations <- page |>
html_nodes('.sc-300a8231-7.eaXxft.dli-title-metadata-item:nth-child(2)') |>
html_text() |>
sapply(parse_duration)
ratings <- page |>
html_nodes('.ipc-rating-star--rating') |>
html_text() |>
as.numeric()
votes <- page |>
html_nodes('.ipc-rating-star--voteCount') |>
html_text() |>
sapply(parse_votes)
return(tibble(
title = titles,
year = years,
duration = durations,
rating = ratings,
votes = votes
))
}
# Main Data Collection
movies_df <- map_df(imdb_urls, scrape_movies)
